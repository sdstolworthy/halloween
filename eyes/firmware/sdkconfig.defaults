# The default 160 MHz leaves too little margin for shading and pushing 8192 pixels per frame.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The render loop runs on the main task, pinned to core 1. Everything networked is pinned to core 0 so it
# can never preempt a frame: Wi-Fi (its default), lwIP's tcpip task, esp-mqtt's task, and the network
# thread (pinned in net.rs). Pinning keeps the render loop at its default priority instead of raising it
# above the networking tasks, which could starve them while a frame runs long.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# 1 ms scheduler tick so a 33 ms frame sleep is 33 ms, not rounded to the default 10 ms tick.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Internal RAM is the scarce resource: the HUB75 DMA buffers want ~2 x 64 KiB of it. The eyes only move a
# few small MQTT messages, so trim Wi-Fi's buffers (Espressif's documented RAM levers).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# Build the HUB75 library in pure ESP-IDF mode (no Arduino / Adafruit-GFX dependency).
CONFIG_ESP32_HUB75_USE_GFX=n
